# Database
DATABASE_URL=postgresql+asyncpg://keyraa:keyraa@localhost:5432/keyraa
DATABASE_URL_SYNC=postgresql://keyraa:keyraa@localhost:5432/keyraa

# Redis
REDIS_URL=redis://localhost:6379/0

# Amadeus API (Self-Service Sandbox)
AMADEUS_CLIENT_ID=your_amadeus_client_id
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret
AMADEUS_BASE_URL=https://test.api.amadeus.com

# Email (Mailhog for local development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=bookings@keyraa.local

# Application
LOG_LEVEL=INFO
DEBUG=true

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
